 "eyebrow": "Trazo - example",
 "title": "How Trazo turns a spec into a page",
 "intro": "Three views of Trazo drawn with Trazo. Hover a node to see who it talks to; click it for its detail and the lines of code it is bound to. Every source below is checked at build time: rename one of those functions and this page stops building.",
 "footer": "Built from examples/pipeline.trazo.json.",
 "sections": [
  {
   "id": "pipeline",
   "eyebrow": "Part 1",
   "title": "The build pipeline",
   "nav": "1. Pipeline",
   "lead": "A spec goes through normalization and validation before anything is rendered. A failing spec writes nothing.",
   "views": [
    {
     "diagram": {
      "id": "pipeline",
      "type": "flow",
      "title": "The build pipeline",
      "description": "A JSON spec is normalized, validated, rendered to SVG and wrapped into a self-contained HTML page; a failed validation stops the build.",
      "size": [
       1000,
       440
      ],
      "nodes": [
       {
        "id": "spec",
        "x": 20,
        "y": 80,
        "kind": "state",
        "tag": "INPUT",
        "name": "doc.trazo.json",
        "sub": [
         "typed JSON",
         "en or es keys"
        ],
        "detail": "The only thing you write. Positions are explicit: there is no automatic layout, on purpose."
       },
       {
        "id": "normalize",
        "x": 220,
        "y": 80,
        "kind": "process",
        "tag": "SCHEMA",
        "name": "Normalize",
        "sub": [
         "aliases, defaults"
        ],
        "detail": "English and Spanish keys map to one internal model, and missing sizes get defaults.",
        "sources": [
         {
          "path": "skills/trazo/lib/esquema.py",
          "contains": "def normalize"
         }
        ]
       },
       {
        "id": "validate",
        "x": 420,
        "y": 80,
        "kind": "gate",
        "tag": "GATE",
        "name": "Validate",
        "sub": [
         "geometry, budget",
         "sources vs repo"
        ],
        "detail": "Blocks crossings, lines behind nodes, covered labels, over-budget diagrams and stale sources. Each error comes with a suggested fix.",
        "sources": [
         {
          "path": "skills/trazo/lib/validar.py",
          "contains": "def validar_documento"
         }
        ]
       },
       {
        "id": "render",
        "x": 620,
        "y": 80,
        "kind": "process",
        "tag": "RENDER",
        "name": "SVG",
        "sub": [
         "orthogonal routes",
         "CSS tokens"
        ],
        "detail": "Routes are orthogonal with quarter-arc corners; colors come from CSS tokens, so the theme can change without redrawing.",
        "sources": [
         {
          "path": "skills/trazo/lib/svg.py",
          "contains": "def svg("
         }
        ]
       },
       {
        "id": "page",
        "x": 820,
        "y": 80,
        "kind": "focus",
        "tag": "OUTPUT",
        "name": "HTML page",
        "sub": [
         "viewer + fonts",
         "works offline"
        ],
        "detail": "One file: CSS, JS, SVG and the typeface are inline. Written atomically, so a failed build never leaves a half-written page.",
        "sources": [
         {
          "path": "skills/trazo/lib/pagina.py",
          "contains": "def construir"
         }
        ]
       },
       {
        "id": "errors",
        "x": 420,
        "y": 260,
        "kind": "pending",
        "tag": "ON FAILURE",
        "name": "Errors + fixes",
        "sub": [
         "nothing is written"
        ],
        "detail": "The previous output stays intact. The command exits with status 1."
       },
       {
        "id": "receipt",
        "x": 820,
        "y": 260,
        "kind": "state",
        "tag": "RECEIPT",
        "name": "sha256",
        "sub": [
         "spec and html"
        ],
        "detail": "The build prints the hash and size of both the spec and the page, so a delivered file can be traced to its spec.",
        "sources": [
         {
          "path": "skills/trazo/trazo.py",
          "contains": "def cmd_build"
         }
        ]
       }
      ],
      "edges": [
       {
        "from": "spec",
